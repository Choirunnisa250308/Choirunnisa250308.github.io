---
import ThemeToggle from "./ThemeToggle.astro"; // gunakan "../components/ThemeToggle.astro" jika di folder layouts
import Icon from './Icon.astro';
import Button from './Button.astro';
import siteConfig from '~/config/site';
import { primaryNav, mobileExtraNav } from '~/data/navigation';

const path = Astro.url.pathname;
const isHome = path === '/' || path === '';

/** Exact match gets `aria-current="page"`; an ancestor section is only styled. */
function state(href: string) {
  if (href === '/') return isHome ? 'page' : null;
  if (path === href) return 'page';
  return path.startsWith(href) ? 'section' : null;
}

/** On the homepage, nav items with an anchor scroll instead of navigating. */
function target(href: string, anchor?: string) {
  return isHome && anchor ? anchor : href;
}
---

<header class="hdr" id="top">
  <div class="wrap hdr-in">
    <a class="brand" href="/">
      <img
        src={siteConfig.logo.header.src}
        alt={`${siteConfig.name} — home`}
        width={siteConfig.logo.header.width}
        height={siteConfig.logo.header.height}
        fetchpriority="high"
        decoding="async"
      />
    </a>

    <nav class="nav" aria-label="Primary">
      {
        primaryNav.map((item) => {
          const s = state(item.href);
          return (
            <a
              href={target(item.href, item.anchor)}
              aria-current={s === 'page' ? 'page' : undefined}
              class={s === 'section' ? 'is-section' : undefined}
            >
              {item.label}
            </a>
          );
        })
      }
    </nav>
    
    <button
  type="button"
  class="lang-btn"
  data-lang-toggle
  aria-label="Ganti bahasa Indonesia dan Inggris"
  aria-pressed="false"
>
  <span data-lang-badge>ID</span>
</button>

    <Button href="/work/" variant="ink" class="hdr-cta">Lihat Projek Saya</Button>
    <ThemeToggle />

    <button class="burger" id="burger" aria-label="Open menu" aria-expanded="false" aria-controls="mnav">
      <Icon name="menu" />
    </button>
  </div>

  <div class="mnav" id="mnav">
    <nav aria-label="Mobile">
      {
        [...primaryNav, ...mobileExtraNav].map((item) => {
          const s = state(item.href);
          return (
            <a href={item.href} aria-current={s === 'page' ? 'page' : undefined}>
              {item.label}
            </a>
          );
        })
      }
    </nav>
    <Button href="/contact/" variant="ink">Send the brief</Button>
  </div>
</header>

<script>
  const burger = document.getElementById('burger');
  const panel = document.getElementById('mnav');

  if (burger && panel) {
    const OPEN_LABEL = 'Open menu';
    const CLOSE_LABEL = 'Close menu';

    const setIcon = (open: boolean) => {
      const use = burger.querySelector('use');
      if (use) use.setAttribute('href', open ? '#i-close' : '#i-menu');
    };

    const setOpen = (open: boolean) => {
      panel.classList.toggle('open', open);
      burger.setAttribute('aria-expanded', open ? 'true' : 'false');
      burger.setAttribute('aria-label', open ? CLOSE_LABEL : OPEN_LABEL);
      setIcon(open);
    };

    burger.addEventListener('click', () => {
      const open = !panel.classList.contains('open');
      setOpen(open);
      if (open) panel.querySelector<HTMLAnchorElement>('a')?.focus();
    });

    // Close after a link is chosen.
    panel.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) setOpen(false);
    });

    // Escape closes and returns focus to the trigger.
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && panel.classList.contains('open')) {
        setOpen(false);
        burger.focus();
      }
    });

    // Never leave the drawer open when it is no longer reachable.
    const wide = window.matchMedia('(min-width: 1001px)');
    wide.addEventListener('change', (e) => {
      if (e.matches) setOpen(false);
    });
  }
</script>

<style>
  /* Warna dasar & animasi link navigasi */
  :global(.hdr .nav a),
  :global(.mnav nav a) {
    position: relative;
    transition: color 0.2s ease;
  }

  /* Garis bawah aksen mengikuti warna teks aktif / hover */
  :global(.hdr .nav a::after) {
    content: "";
    display: block;
    height: 2px;
    width: 0;
    margin-top: 2px;
    background: currentColor;
    transition: width 0.2s ease;
  }

  :global(.hdr .nav a:hover::after),
  :global(.hdr .nav a[aria-current="page"]::after),
  :global(.hdr .nav a.is-section::after) {
    width: 100%;
  }

  /* --- MODE TERANG --- */
  :global(html:not(.dark):not([data-theme="dark"])) :global(.hdr .nav a),
  :global(html:not(.dark):not([data-theme="dark"])) :global(.mnav nav a) {
    color: #334155;
  }

  :global(html:not(.dark):not([data-theme="dark"])) :global(.hdr .nav a:nth-child(1):hover),
  :global(html:not(.dark):not([data-theme="dark"])) :global(.hdr .nav a:nth-child(1)[aria-current="page"]),
  :global(html:not(.dark):not([data-theme="dark"])) :global(.hdr .nav a:nth-child(1).is-section),
  :global(html:not(.dark):not([data-theme="dark"])) :global(.mnav nav a:nth-child(1):hover),
  :global(html:not(.dark):not([data-theme="dark"])) :global(.mnav nav a:nth-child(1)[aria-current="page"]) {
    color: #2563eb; /* Biru */
  }

  :global(html:not(.dark):not([data-theme="dark"])) :global(.hdr .nav a:nth-child(2):hover),
  :global(html:not(.dark):not([data-theme="dark"])) :global(.hdr .nav a:nth-child(2)[aria-current="page"]),
  :global(html:not(.dark):not([data-theme="dark"])) :global(.hdr .nav a:nth-child(2).is-section),
  :global(html:not(.dark):not([data-theme="dark"])) :global(.mnav nav a:nth-child(2):hover),
  :global(html:not(.dark):not([data-theme="dark"])) :global(.mnav nav a:nth-child(2)[aria-current="page"]) {
    color: #0d9488; /* Teal */
  }

  :global(html:not(.dark):not([data-theme="dark"])) :global(.hdr .nav a:nth-child(3):hover),
  :global(html:not(.dark):not([data-theme="dark"])) :global(.hdr .nav a:nth-child(3)[aria-current="page"]),
  :global(html:not(.dark):not([data-theme="dark"])) :global(.hdr .nav a:nth-child(3).is-section),
  :global(html:not(.dark):not([data-theme="dark"])) :global(.mnav nav a:nth-child(3):hover),
  :global(html:not(.dark):not([data-theme="dark"])) :global(.mnav nav a:nth-child(3)[aria-current="page"]) {
    color: #7c3aed; /* Ungu */
  }

  :global(html:not(.dark):not([data-theme="dark"])) :global(.hdr .nav a:nth-child(4):hover),
  :global(html:not(.dark):not([data-theme="dark"])) :global(.hdr .nav a:nth-child(4)[aria-current="page"]),
  :global(html:not(.dark):not([data-theme="dark"])) :global(.hdr .nav a:nth-child(4).is-section),
  :global(html:not(.dark):not([data-theme="dark"])) :global(.mnav nav a:nth-child(4):hover),
  :global(html:not(.dark):not([data-theme="dark"])) :global(.mnav nav a:nth-child(4)[aria-current="page"]) {
    color: #db2777; /* Pink */
  }

  /* --- MODE GELAP --- */
  :global(:is(html.dark, html[data-theme="dark"])) :global(.hdr .nav a),
  :global(:is(html.dark, html[data-theme="dark"])) :global(.mnav nav a) {
    color: #e2e8f0;
  }

  :global(:is(html.dark, html[data-theme="dark"])) :global(.hdr .nav a:nth-child(1):hover),
  :global(:is(html.dark, html[data-theme="dark"])) :global(.hdr .nav a:nth-child(1)[aria-current="page"]),
  :global(:is(html.dark, html[data-theme="dark"])) :global(.hdr .nav a:nth-child(1).is-section),
  :global(:is(html.dark, html[data-theme="dark"])) :global(.mnav nav a:nth-child(1):hover),
  :global(:is(html.dark, html[data-theme="dark"])) :global(.mnav nav a:nth-child(1)[aria-current="page"]) {
    color: #60a5fa; /* Biru muda */
  }

  :global(:is(html.dark, html[data-theme="dark"])) :global(.hdr .nav a:nth-child(2):hover),
  :global(:is(html.dark, html[data-theme="dark"])) :global(.hdr .nav a:nth-child(2)[aria-current="page"]),
  :global(:is(html.dark, html[data-theme="dark"])) :global(.hdr .nav a:nth-child(2).is-section),
  :global(:is(html.dark, html[data-theme="dark"])) :global(.mnav nav a:nth-child(2):hover),
  :global(:is(html.dark, html[data-theme="dark"])) :global(.mnav nav a:nth-child(2)[aria-current="page"]) {
    color: #2dd4bf; /* Teal cerah */
  }

  :global(:is(html.dark, html[data-theme="dark"])) :global(.hdr .nav a:nth-child(3):hover),
  :global(:is(html.dark, html[data-theme="dark"])) :global(.hdr .nav a:nth-child(3)[aria-current="page"]),
  :global(:is(html.dark, html[data-theme="dark"])) :global(.hdr .nav a:nth-child(3).is-section),
  :global(:is(html.dark, html[data-theme="dark"])) :global(.mnav nav a:nth-child(3):hover),
  :global(:is(html.dark, html[data-theme="dark"])) :global(.mnav nav a:nth-child(3)[aria-current="page"]) {
    color: #c084fc; /* Ungu cerah */
  }

  :global(:is(html.dark, html[data-theme="dark"])) :global(.hdr .nav a:nth-child(4):hover),
  :global(:is(html.dark, html[data-theme="dark"])) :global(.hdr .nav a:nth-child(4)[aria-current="page"]),
  :global(:is(html.dark, html[data-theme="dark"])) :global(.hdr .nav a:nth-child(4).is-section),
  :global(:is(html.dark, html[data-theme="dark"])) :global(.mnav nav a:nth-child(4):hover),
  :global(:is(html.dark, html[data-theme="dark"])) :global(.mnav nav a:nth-child(4)[aria-current="page"]) {
    color: #f472b6; /* Pink cerah */
  }
</style>
