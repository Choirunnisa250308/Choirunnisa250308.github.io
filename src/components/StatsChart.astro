---
interface Props {
  title?: string;
  namespace?: string;
  syncStatSelector?: string;
  startFromZero?: boolean;
}

const {
  title = "Statistik Pengunjung Portofolio",
  namespace = "choirunnisa250308-portfolio",
  syncStatSelector = "[data-count]",
  startFromZero = true,
} = Astro.props;
---

<div
  class="stats-chart-card"
  data-namespace={namespace}
  data-sync-selector={syncStatSelector}
  data-start-zero={startFromZero ? "true" : "false"}
  id="visitorChartCard"
>
  <div class="stats-chart-top">
    <div>
      <h3 class="stats-chart-title">{title}</h3>
      <p class="stats-chart-sub" id="visitorStatusText">
        Memuat data kunjungan terbaru...
      </p>
    </div>
    <div class="stats-chart-badges">
      <span class="stats-chart-total" id="visitorTotalBadge">Total: -</span>
      <span class="stats-chart-pill" id="visitorLivePill">Live / Terupdate</span>
    </div>
  </div>

  <div class="stats-chart-canvas-box">
    <canvas id="bandStatsChart"></canvas>
  </div>
</div>

<script>
  import Chart from "chart.js/auto";

  const cardEl = document.getElementById("visitorChartCard") as HTMLElement | null;
  const chartCanvas = document.getElementById("bandStatsChart") as HTMLCanvasElement | null;
  const statusText = document.getElementById("visitorStatusText");
  const totalBadge = document.getElementById("visitorTotalBadge");
  const livePill = document.getElementById("visitorLivePill");

  const MONTH_NAMES_ID = [
    "Jan", "Feb", "Mar", "Apr", "Mei", "Jun",
    "Jul", "Agu", "Sep", "Okt", "Nov", "Des",
  ];

  const BAR_COLORS = [
    "#38bdf8",
    "#a78bfa",
    "#f472b6",
    "#fb923c",
    "#c8f14d",
    "#2dd4bf",
    "#facc15",
    "#60a5fa",
    "#c084fc",
    "#fb7185",
    "#34d399",
    "#fde047",
  ];

  const BORDER_COLORS = [
    "#0284c7",
    "#8b5cf6",
    "#ec4899",
    "#f97316",
    "#b4e032",
    "#14b8a6",
    "#eab308",
    "#2563eb",
    "#9333ea",
    "#e11d48",
    "#059669",
    "#ca8a04",
  ];

  // Data bulan-bulan sebelumnya (bulan berjalan otomatis mulai dari 0 jika startFromZero aktif)
  const INITIAL_SERIES: Record<string, number> = {
    Mei: 120,
    Jun: 185,
    Jul: 240,
    Agu: 210,
    Sep: 310,
    Okt: 390,
    Nov: 0,
  };

  let chartInstance: Chart | null = null;

  function renderChart(labels: string[], values: number[]) {
    if (!chartCanvas) return;

    if (chartInstance) {
      chartInstance.destroy();
    }

    chartInstance = new Chart(chartCanvas, {
      type: "bar",
      data: {
        labels,
        datasets: [
          {
            label: "Jumlah Pengunjung",
            data: values,
            backgroundColor: labels.map((_, idx) => BAR_COLORS[idx % BAR_COLORS.length]),
            borderColor: labels.map((_, idx) => BORDER_COLORS[idx % BORDER_COLORS.length]),
            borderWidth: 1.5,
            borderRadius: 8,
            maxBarThickness: 54,
          },
        ],
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        animation: {
          duration: 600,
        },
        plugins: {
          legend: {
            labels: {
              color: "#334155",
              font: {
                size: 12,
                weight: 600,
              },
            },
          },
          tooltip: {
            callbacks: {
              label: (ctx) => ` ${ctx.parsed.y ?? 0} kunjungan`,
            },
          },
        },
        scales: {
          x: {
            ticks: {
              color: "#475569",
            },
            grid: {
              color: "rgba(15, 23, 42, 0.08)",
            },
          },
          y: {
            beginAtZero: true,
            ticks: {
              color: "#475569",
              precision: 0,
            },
            grid: {
              color: "rgba(15, 23, 42, 0.08)",
            },
          },
        },
      },
    });
  }

  function syncStatCards(liveMonthCount: number) {
    const selector = cardEl?.dataset.syncSelector;
    if (!selector) return;

    const targets = document.querySelectorAll<HTMLElement>(selector);
    targets.forEach((el) => {
      const parentText = el.parentElement?.textContent?.toLowerCase() ?? "";
      if (parentText.includes("kunjungan") || targets.length === 1) {
        const suffix = el.dataset.suffix ?? "";
        el.dataset.count = String(liveMonthCount);
        el.textContent = `${liveMonthCount.toLocaleString("id-ID")}${suffix}`;
      }
    });
  }

  function updateTotalBadge(values: number[], activeMonthCount: number) {
    const sum = values.reduce((acc, num) => acc + (Number.isFinite(num) ? num : 0), 0);
    if (totalBadge) {
      totalBadge.textContent = `Total: ${sum.toLocaleString("id-ID")}`;
    }
    syncStatCards(activeMonthCount);
  }

  async function loadVisitorChart() {
    if (!chartCanvas) return;

    const namespace = cardEl?.dataset.namespace || "choirunnisa250308-portfolio";
    const startFromZero = cardEl?.dataset.startZero !== "false";
    const now = new Date();
    const year = now.getFullYear();
    const monthIndex = now.getMonth();
    const monthLabel = MONTH_NAMES_ID[monthIndex];
    const baseMonthKey = `${year}-${String(monthIndex + 1).padStart(2, "0")}`;
    const counterKey = startFromZero ? `${baseMonthKey}-v0` : baseMonthKey;

    const labels = Object.keys(INITIAL_SERIES);
    const values = Object.values(INITIAL_SERIES);

    if (!labels.includes(monthLabel)) {
      labels.push(monthLabel);
      values.push(0);
    }

    const activeIdx = labels.indexOf(monthLabel);
    if (startFromZero && activeIdx !== -1) {
      values[activeIdx] = 0;
    }

    const initialActiveVal = activeIdx !== -1 ? values[activeIdx] : 0;
    updateTotalBadge(values, initialActiveVal);
    renderChart(labels, values);

    try {
      const endpoint = `https://api.counterapi.dev/v1/${encodeURIComponent(namespace)}/${encodeURIComponent(counterKey)}/up`;
      const res = await fetch(endpoint, { cache: "no-store" });

      if (!res.ok) {
        throw new Error(`HTTP ${res.status}`);
      }

      const payload = await res.json();
      const rawCount = Number(payload?.count ?? payload?.value);

      if (!Number.isNaN(rawCount) && activeIdx !== -1) {
        // Jika startFromZero aktif, hit pertama menghasilkan 1, hit kedua 2, dst.
        const liveCount = Math.max(0, rawCount);
        values[activeIdx] = liveCount;
        updateTotalBadge(values, liveCount);
        renderChart(labels, values);

        if (statusText) {
          statusText.textContent = `Terupdate otomatis (${monthLabel} ${year}, mulai dari 0): ${liveCount.toLocaleString("id-ID")} kunjungan`;
        }
        if (livePill) {
          livePill.textContent = "Live / Terupdate";
        }
      }
    } catch (err) {
      console.warn("CounterAPI tidak terjangkau, memakai penghitung lokal mulai dari 0:", err);

      const storageKey = `visitor_zero_${namespace}_${counterKey}`;
      const savedCount = Number(localStorage.getItem(storageKey));
      const nextLocalCount = Number.isFinite(savedCount) && savedCount >= 0 ? savedCount + 1 : 1;

      try {
        localStorage.setItem(storageKey, String(nextLocalCount));
      } catch {
        // Abaikan jika storage diblokir
      }

      if (activeIdx !== -1) {
        values[activeIdx] = nextLocalCount;
        updateTotalBadge(values, nextLocalCount);
        renderChart(labels, values);
      }

      if (statusText) {
        statusText.textContent = `Mode lokal (${monthLabel} ${year}, mulai dari 0): ${nextLocalCount.toLocaleString("id-ID")} kunjungan`;
      }
      if (livePill) {
        livePill.textContent = "Lokal / Terupdate";
      }
    }
  }

  loadVisitorChart();
</script>

<style>
  .stats-chart-card {
    width: 100%;
    max-width: 820px;
    margin: 0 auto;
    padding: 1.75rem 2rem;
    border-radius: 20px;
    background: rgba(255, 255, 255, 0.92);
    border: 1px solid rgba(15, 23, 42, 0.12);
    color: #0f172a;
    text-align: left;
    box-sizing: border-box;
  }

  .stats-chart-top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }

  .stats-chart-title {
    margin: 0 0 0.3rem;
    font-size: 1.2rem;
    color: #0f172a;
  }

  .stats-chart-sub {
    margin: 0;
    font-size: 0.9rem;
    color: #475569;
  }

  .stats-chart-badges {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .stats-chart-total {
    padding: 0.35rem 0.75rem;
    border-radius: 999px;
    font-size: 0.8rem;
    font-weight: 600;
    color: #0f172a;
    background: rgba(15, 23, 42, 0.06);
    border: 1px solid rgba(15, 23, 42, 0.14);
    white-space: nowrap;
  }

  .stats-chart-pill {
    padding: 0.35rem 0.85rem;
    border-radius: 999px;
    font-size: 0.8rem;
    font-weight: 600;
    color: #0369a1;
    background: rgba(56, 189, 248, 0.18);
    border: 1px solid rgba(2, 132, 199, 0.35);
    white-space: nowrap;
  }

  .stats-chart-canvas-box {
    position: relative;
    width: 100%;
    height: 310px;
  }

  @media (max-width: 640px) {
    .stats-chart-card {
      padding: 1.25rem;
    }

    .stats-chart-top {
      flex-direction: column;
      align-items: flex-start;
    }

    .stats-chart-canvas-box {
      height: 250px;
    }
  }
</style>