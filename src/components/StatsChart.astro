<div class="stats-chart-card">
  <div class="stats-chart-top">
    <div>
      <h3 class="stats-chart-title">Statistik Pengunjung Portofolio</h3>
      <p class="stats-chart-sub" id="visitorStatusText">Memuat data kunjungan terbaru...</p>
    </div>
    <span class="stats-chart-pill">Live / Terupdate</span>
  </div>

  <div class="stats-chart-canvas-box">
    <canvas id="bandStatsChart"></canvas>
  </div>
</div>

<script>
  import Chart from "chart.js/auto";

  const chartCanvas = document.getElementById("bandStatsChart") as HTMLCanvasElement | null;
  const statusText = document.getElementById("visitorStatusText");

  const barColors = [
    "#38bdf8",
    "#a78bfa",
    "#f472b6",
    "#fb923c",
    "#c8f14d",
    "#2dd4bf",
    "#facc15",
  ];

  const borderColors = [
    "#0284c7",
    "#8b5cf6",
    "#ec4899",
    "#f97316",
    "#b4e032",
    "#14b8a6",
    "#eab308",
  ];

  async function loadVisitorChart() {
    if (!chartCanvas) return;

    // Data awal cadangan jika endpoint belum tersedia
    let labels = ["Mei", "Jun", "Jul", "Agu", "Sep", "Okt", "Nov"];
    let values = [120, 185, 240, 210, 310, 390, 425];

    try {
      // Ganti '/api/visitors' dengan URL API / JSON / Supabase / Google Analytics kamu
      const res = await fetch("/api/visitors", { cache: "no-store" });
      if (res.ok) {
        const payload = await res.json();
        if (Array.isArray(payload.labels) && Array.isArray(payload.values)) {
          labels = payload.labels;
          values = payload.values;
          if (statusText) {
            statusText.textContent = "Data terupdate otomatis dari sumber kunjungan";
          }
        }
      } else if (statusText) {
        statusText.textContent = "Menampilkan data awal (hubungkan API untuk data live)";
      }
    } catch {
      if (statusText) {
        statusText.textContent = "Menampilkan data awal (hubungkan API untuk data live)";
      }
    }

    new Chart(chartCanvas, {
      type: "bar",
      data: {
        labels,
        datasets: [
          {
            label: "Jumlah Pengunjung",
            data: values,
            backgroundColor: labels.map((_, i) => barColors[i % barColors.length]),
            borderColor: labels.map((_, i) => borderColors[i % borderColors.length]),
            borderWidth: 1.5,
            borderRadius: 8,
          },
        ],
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: {
          legend: {
            labels: {
              color: "#e5e7eb",
            },
          },
        },
        scales: {
          x: {
            ticks: { color: "#d1d5db" },
            grid: { color: "rgba(255, 255, 255, 0.08)" },
          },
          y: {
            beginAtZero: true,
            ticks: {
              color: "#d1d5db",
              precision: 0,
            },
            grid: { color: "rgba(255, 255, 255, 0.08)" },
          },
        },
      },
    });
  }

  loadVisitorChart();
</script>

<style>
  .stats-chart-card {
    width: 100%;
    max-width: 820px;
    margin: 0 auto;
    padding: 1.75rem 2rem;
    border-radius: 20px;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.12);
    color: #f9fafb;
    text-align: left;
    box-sizing: border-box;
  }

  .stats-chart-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }

  .stats-chart-title {
    margin: 0 0 0.3rem;
    font-size: 1.2rem;
    color: #ffffff;
  }

  .stats-chart-sub {
    margin: 0;
    font-size: 0.9rem;
    color: #cbd5e1;
  }

  .stats-chart-pill {
    padding: 0.35rem 0.85rem;
    border-radius: 999px;
    font-size: 0.8rem;
    font-weight: 600;
    color: #7dd3fc;
    background: rgba(56, 189, 248, 0.14);
    border: 1px solid rgba(56, 189, 248, 0.38);
    white-space: nowrap;
  }

  .stats-chart-canvas-box {
    position: relative;
    width: 100%;
    height: 310px;
  }

  @media (max-width: 640px) {
    .stats-chart-card {
      padding: 1.25rem;
    }

    .stats-chart-top {
      flex-direction: column;
      align-items: flex-start;
    }

    .stats-chart-canvas-box {
      height: 250px;
    }
  }
</style>