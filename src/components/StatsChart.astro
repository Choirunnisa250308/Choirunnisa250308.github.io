---
interface Props {
  title?: string;
  namespace?: string;
}

const {
  title = "Statistik Pengunjung Portofolio",
  namespace = "choirunnisa250308-portfolio",
} = Astro.props;
---

<div
  class="stats-chart-card"
  data-namespace={namespace}
  id="visitorChartCard"
>
  <div class="stats-chart-top">
    <div>
      <h3 class="stats-chart-title">{title}</h3>
      <p class="stats-chart-sub" id="visitorStatusText">
        Memuat data kunjungan terbaru...
      </p>
    </div>
    <div class="stats-chart-badges">
      <span class="stats-chart-total" id="visitorTotalBadge">Total: -</span>
      <span class="stats-chart-pill" id="visitorLivePill">Live / Terupdate</span>
    </div>
  </div>

  <div class="stats-chart-canvas-box">
    <canvas id="bandStatsChart"></canvas>
  </div>
</div>

<script>
  import Chart from "chart.js/auto";

  const cardEl = document.getElementById("visitorChartCard") as HTMLElement | null;
  const chartCanvas = document.getElementById("bandStatsChart") as HTMLCanvasElement | null;
  const statusText = document.getElementById("visitorStatusText");
  const totalBadge = document.getElementById("visitorTotalBadge");
  const livePill = document.getElementById("visitorLivePill");

  const MONTH_NAMES_ID = [
    "Jan", "Feb", "Mar", "Apr", "Mei", "Jun",
    "Jul", "Agu", "Sep", "Okt", "Nov", "Des",
  ];

  const BAR_COLORS = [
    "#38bdf8",
    "#a78bfa",
    "#f472b6",
    "#fb923c",
    "#c8f14d",
    "#2dd4bf",
    "#facc15",
    "#60a5fa",
    "#c084fc",
    "#fb7185",
    "#34d399",
    "#fde047",
  ];

  const BORDER_COLORS = [
    "#0284c7",
    "#8b5cf6",
    "#ec4899",
    "#f97316",
    "#b4e032",
    "#14b8a6",
    "#eab308",
    "#2563eb",
    "#9333ea",
    "#e11d48",
    "#059669",
    "#ca8a04",
  ];

  // Data awal cadangan per label bulan
  const INITIAL_SERIES: Record<string, number> = {
    Mei: 120,
    Jun: 185,
    Jul: 240,
    Agu: 210,
    Sep: 310,
    Okt: 390,
    Nov: 425,
  };

  let chartInstance: Chart | null = null;

  function renderChart(labels: string[], values: number[]) {
    if (!chartCanvas) return;

    if (chartInstance) {
      chartInstance.destroy();
    }

    chartInstance = new Chart(chartCanvas, {
      type: "bar",
      data: {
        labels,
        datasets: [
          {
            label: "Jumlah Pengunjung",
            data: values,
            backgroundColor: labels.map((_, idx) => BAR_COLORS[idx % BAR_COLORS.length]),
            borderColor: labels.map((_, idx) => BORDER_COLORS[idx % BORDER_COLORS.length]),
            borderWidth: 1.5,
            borderRadius: 8,
            maxBarThickness: 54,
          },
        ],
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        animation: {
          duration: 600,
        },
        plugins: {
          legend: {
            labels: {
              color: "#e5e7eb",
              font: {
                size: 12,
              },
            },
          },
          tooltip: {
            callbacks: {
              label: (ctx) => ` ${ctx.parsed.y ?? 0} kunjungan`,
            },
          },
        },
        scales: {
          x: {
            ticks: {
              color: "#d1d5db",
            },
            grid: {
              color: "rgba(255, 255, 255, 0.08)",
            },
          },
          y: {
            beginAtZero: true,
            ticks: {
              color: "#d1d5db",
              precision: 0,
            },
            grid: {
              color: "rgba(255, 255, 255, 0.08)",
            },
          },
        },
      },
    });
  }

  function updateTotalBadge(values: number[]) {
    if (!totalBadge) return;
    const sum = values.reduce((acc, num) => acc + (Number.isFinite(num) ? num : 0), 0);
    totalBadge.textContent = `Total: ${sum.toLocaleString("id-ID")}`;
  }

  async function loadVisitorChart() {
    if (!chartCanvas) return;

    const namespace = cardEl?.dataset.namespace || "choirunnisa250308-portfolio";
    const now = new Date();
    const year = now.getFullYear();
    const monthIndex = now.getMonth();
    const monthLabel = MONTH_NAMES_ID[monthIndex];
    const monthKey = `${year}-${String(monthIndex + 1).padStart(2, "0")}`;

    const labels = Object.keys(INITIAL_SERIES);
    const values = Object.values(INITIAL_SERIES);

    if (!labels.includes(monthLabel)) {
      labels.push(monthLabel);
      values.push(0);
    }

    const activeIdx = labels.indexOf(monthLabel);
    updateTotalBadge(values);
    renderChart(labels, values);

    try {
      const endpoint = `https://api.counterapi.dev/v1/${encodeURIComponent(namespace)}/${encodeURIComponent(monthKey)}/up`;
      const res = await fetch(endpoint, { cache: "no-store" });

      if (!res.ok) {
        throw new Error(`HTTP ${res.status}`);
      }

      const payload = await res.json();
      const liveCount = Number(payload?.count);

      if (!Number.isNaN(liveCount) && activeIdx !== -1) {
        values[activeIdx] = liveCount;
        updateTotalBadge(values);
        renderChart(labels, values);

        if (statusText) {
          statusText.textContent = `Terupdate otomatis (${monthLabel} ${year}): ${liveCount.toLocaleString("id-ID")} kunjungan tercatat`;
        }
        if (livePill) {
          livePill.textContent = "Live / Terupdate";
        }
      }
    } catch {
      if (statusText) {
        statusText.textContent = `Menampilkan data awal (${monthLabel} ${year} — counter sedang tidak terjangkau)`;
      }
      if (livePill) {
        livePill.textContent = "Data Awal";
      }
    }
  }

  loadVisitorChart();
</script>

<style>
  .stats-chart-card {
    width: 100%;
    max-width: 820px;
    margin: 0 auto;
    padding: 1.75rem 2rem;
    border-radius: 20px;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.12);
    color: #f9fafb;
    text-align: left;
    box-sizing: border-box;
  }

  .stats-chart-top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }

  .stats-chart-title {
    margin: 0 0 0.3rem;
    font-size: 1.2rem;
    color: #ffffff;
  }

  .stats-chart-sub {
    margin: 0;
    font-size: 0.9rem;
    color: #cbd5e1;
  }

  .stats-chart-badges {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .stats-chart-total {
    padding: 0.35rem 0.75rem;
    border-radius: 999px;
    font-size: 0.8rem;
    font-weight: 600;
    color: #e2e8f0;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.16);
    white-space: nowrap;
  }

  .stats-chart-pill {
    padding: 0.35rem 0.85rem;
    border-radius: 999px;
    font-size: 0.8rem;
    font-weight: 600;
    color: #7dd3fc;
    background: rgba(56, 189, 248, 0.14);
    border: 1px solid rgba(56, 189, 248, 0.38);
    white-space: nowrap;
  }

  .stats-chart-canvas-box {
    position: relative;
    width: 100%;
    height: 310px;
  }

  @media (max-width: 640px) {
    .stats-chart-card {
      padding: 1.25rem;
    }

    .stats-chart-top {
      flex-direction: column;
      align-items: flex-start;
    }

    .stats-chart-canvas-box {
      height: 250px;
    }
  }
</style>