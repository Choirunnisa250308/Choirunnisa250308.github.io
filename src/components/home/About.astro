---
import Icon from '../Icon.astro';
import Button from '../Button.astro';
import Signature from '../art/Signature.astro';
import siteConfig from '~/config/site';
import { about } from '~/data/highlights';

interface Props {
  /** `h1` when the About page renders this as its main heading. */
  headingLevel?: 'h1' | 'h2';
  id?: string;
}

const { headingLevel: Heading = 'h2', id = 'about' } = Astro.props;
---

<section class="wrap sec" id={id} aria-labelledby="about-h">
  <div class="about-grid">
    <div class="about-img rev">
      <img
        src={about.image.src}
        alt={about.image.alt}
        width={about.image.width}
        height={about.image.height}
        loading="lazy"
        decoding="async"
      />
      <div class="about-badge">
        <b>{about.badge.value}</b>
        <span>{about.badge.label}</span>
      </div>
    </div>

    <div class="rev rev-d1">
      <p class="eyebrow">{about.eyebrow}</p>
      <Heading class="d2 about-h" id="about-h">{about.title}</Heading>
      <p class="lead">{about.body}</p>

      <ul class="about-list">
        {
          about.points.map((point) => (
            <li>
              <i><Icon name="check" class="ic-xs" /></i>
              <span>{point}</span>
            </li>
          ))
        }
      </ul>

      <div class="about-sign">
        <Signature label={`Signature of ${siteConfig.author}`} />
        <Button href={about.ctaHref} variant="outline">{about.ctaLabel}</Button>
      </div>
    </div>
  </div>
</section>

<style>
  :global(html.dark) .about-sign :is(a, button, .btn, [class*="btn"]),
  :global(html[data-theme="dark"]) .about-sign :is(a, button, .btn, [class*="btn"]) {
    color: #f8fafc;
    border-color: rgba(248, 250, 252, 0.35);
    background-color: rgba(255, 255, 255, 0.06);
  }

  :global(html.dark) .about-sign :is(a, button, .btn, [class*="btn"]) :is(span, b, strong),
  :global(html[data-theme="dark"]) .about-sign :is(a, button, .btn, [class*="btn"]) :is(span, b, strong) {
    color: inherit;
  }

  :global(html.dark) .about-sign :is(a, button, .btn, [class*="btn"]):hover,
  :global(html[data-theme="dark"]) .about-sign :is(a, button, .btn, [class*="btn"]):hover {
    background-color: rgba(255, 255, 255, 0.14);
  }
</style>
