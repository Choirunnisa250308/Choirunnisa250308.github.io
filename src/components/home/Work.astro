---
import WorkCard from '~/components/cards/WorkCard.astro';
import { getCollection } from 'astro:content';
import { isVisible } from '~/lib/utils';

const featuredProjects = (await getCollection('projects'))
  .filter(isVisible)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 3);
---

<section class="wrap sec selected-work" aria-labelledby="home-work-heading">
  <div class="section-head section-head--left">
    <div>
      <p class="eyebrow">PROYEK SAYA</p>
      <h2 id="home-work-heading">Tiga proyek pilihan di bidang data &amp; web.</h2>
    </div>
    <a class="btn-link btn-all-projects" href="/work/">Lihat Semua proyek ↗</a>
  </div>

  <div class="work-grid" style="margin-top:clamp(24px,2.8vw,38px)">
    {
      featuredProjects.map((project, i) => (
        <WorkCard
          project={project}
          eager={i < 2}
          class:list={['rev', i % 3 > 0 && `rev-d${i % 3}`]}
        />
      ))
    }
  </div>
</section>