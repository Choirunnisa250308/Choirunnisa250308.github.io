---
import PageLayout from '~/layouts/PageLayout.astro';
import ContactForm from '~/components/ContactForm.astro';
import Icon from '~/components/Icon.astro';
import Faq from '~/components/home/Faq.astro';
import siteConfig from '~/config/site';
import { graph, personSchema, breadcrumbSchema } from '~/lib/jsonld';

const jsonLd = graph([
  personSchema(siteConfig),
  breadcrumbSchema([
    { name: 'Home', url: `${siteConfig.url}/` },
    { name: 'Contact', url: `${siteConfig.url}/contact/` },
  ]),
]);
---

<PageLayout
  title="Kontak"
  heading="Mulai dari hal yang penting."
  eyebrow="Kontak"
  intro="Ceritakan persoalan yang ingin dipecahkan, siapa yang terdampak, dan hasil apa yang ingin dicapai. Cukup dengan konteks singkat atau gambaran data awal, kita sudah bisa berdiskusi mengenai langkah analisis maupun pengerjaannya."
  description={`Hubungi ${siteConfig.author} untuk kolaborasi analisis data statistik, riset, visualisasi data, maupun pengembangan antarmuka web.`}
  crumbs={[{ label: 'Kontak' }]}
  jsonLd={jsonLd}
>
  <section class="wrap sec contact-accent-scope" style="padding-top:0" aria-labelledby="form-h">
    <div class="contact-grid">
      <div class="rev">
        <div class="contact-form-head">
          <h2 class="d3" id="form-h" style="margin-bottom:6px">Kirim ringkasan kebutuhan</h2>
          <p class="contact-note">Biasanya dibalas dalam 1–2 hari kerja.</p>
        </div>
        <ContactForm />
      </div>

      <div class="contact-aside rev rev-d1">
        <div class="contact-card contact-card--teal">
          <i><Icon name="mail" /></i>
          <div class="contact-card__body">
            <b>Email</b>
            <a class="contact-link" href={`mailto:${siteConfig.contact.email}`}>
              {siteConfig.contact.email}
            </a>
          </div>
          <button
            type="button"
            class="copy-chip"
            data-copy={siteConfig.contact.email}
            aria-label="Salin alamat email"
          >
            Salin
          </button>
        </div>

        <div class="contact-card contact-card--teal">
          <i><Icon name="phone" /></i>
          <div class="contact-card__body">
            <b>Telepon / WhatsApp</b>
            <a class="contact-link" href={`tel:${siteConfig.contact.phoneHref}`}>
              {siteConfig.contact.phone}
            </a>
          </div>
          <button
            type="button"
            class="copy-chip"
            data-copy={siteConfig.contact.phone}
            aria-label="Salin nomor telepon"
          >
            Salin
          </button>
        </div>

        <div class="contact-card contact-card--warm">
          <i><Icon name="pin" /></i>
          <div class="contact-card__body">
            <b>Domisili</b>
            <span>{siteConfig.contact.location}</span>
          </div>
        </div>

        <div class="contact-card contact-card--highlight">
          <i><Icon name="spark" /></i>
          <div class="contact-card__body">
            <b>Ketersediaan</b>
            <span>{siteConfig.contact.availability}</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <Faq />
</PageLayout>


<style>
  .contact-accent-scope {
    --accent-primary: #0f766e;
    --accent-primary-soft: rgba(15, 118, 110, 0.08);
    --accent-primary-border: rgba(15, 118, 110, 0.28);
    --accent-warm: #b45309;
    --accent-warm-soft: rgba(180, 83, 9, 0.07);
    --accent-warm-border: rgba(180, 83, 9, 0.24);
  }

  :global(.dark) .contact-accent-scope {
    --accent-primary: #2dd4bf;
    --accent-primary-soft: rgba(45, 212, 191, 0.1);
    --accent-primary-border: rgba(45, 212, 191, 0.32);
    --accent-warm: #fbbf24;
    --accent-warm-soft: rgba(251, 191, 36, 0.09);
    --accent-warm-border: rgba(251, 191, 36, 0.28);
  }

  .contact-form-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 8px 16px;
    margin-bottom: 20px;
  }

  .contact-note {
    margin: 0;
    font-size: 0.875rem;
    color: var(--accent-primary);
    font-weight: 500;
  }

  .contact-card {
    position: relative;
    transition: transform 0.2s ease, border-color 0.2s ease, background-color 0.2s ease, box-shadow 0.2s ease;
  }

  .contact-card__body {
    flex: 1;
    min-width: 0;
  }

  .contact-link {
    text-decoration: none;
    color: inherit;
    word-break: break-word;
  }

  .contact-link:hover {
    color: var(--accent-primary);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .contact-card--teal:hover {
    transform: translateY(-2px);
    border-color: var(--accent-primary-border);
    background-color: var(--accent-primary-soft);
  }

  .contact-card--teal:hover i {
    color: var(--accent-primary);
  }

  .contact-card--warm {
    border-color: var(--accent-warm-border);
    background-color: var(--accent-warm-soft);
  }

  .contact-card--warm:hover {
    transform: translateY(-2px);
  }

  .contact-card--warm i {
    color: var(--accent-warm);
  }

  .contact-card--highlight {
    border-color: var(--accent-primary-border);
    background: linear-gradient(
      135deg,
      var(--accent-primary-soft) 0%,
      var(--accent-warm-soft) 100%
    );
  }

  .contact-card--highlight:hover {
    transform: translateY(-2px);
  }

  .contact-card--highlight i {
    color: var(--accent-primary);
  }

  .copy-chip {
    border: 1px solid var(--accent-primary-border);
    background: transparent;
    color: var(--accent-primary);
    border-radius: 999px;
    padding: 4px 10px;
    font-size: 0.75rem;
    font-weight: 500;
    line-height: 1.2;
    cursor: pointer;
    transition: transform 0.18s ease, background-color 0.18s ease, color 0.18s ease;
    flex-shrink: 0;
  }

  .copy-chip:hover {
    background-color: var(--accent-primary);
    color: #ffffff;
    transform: scale(1.03);
  }

  :global(.dark) .copy-chip:hover {
    color: #090d16;
  }

  .copy-chip.is-copied {
    background-color: var(--accent-primary);
    color: #ffffff;
    font-weight: 600;
  }

  :global(.dark) .copy-chip.is-copied {
    color: #090d16;
  }
  :global(.page-head p),
  :global(.hero p),
  :global(main > header p),
  .contact-note {
    text-align: justify;
    text-justify: inter-word;
    hyphens: auto;
  }

  :global(.page-head h1),
  :global(.hero h1),
  :global(main > header h1) {
    text-align: justify;
    text-align-last: left;
    max-width: 22ch;
    line-height: 1.06;
  }

  .contact-section {
    padding-top: 8px !important;
  }
</style>

<script>
  document.querySelectorAll<HTMLButtonElement>('.copy-chip').forEach((btn) => {
    btn.addEventListener('click', async (event) => {
      event.stopPropagation();
      const value = btn.dataset.copy;
      if (!value) return;

      try {
        await navigator.clipboard.writeText(value);
        const prevText = btn.textContent;
        btn.textContent = 'Tersalin!';
        btn.classList.add('is-copied');
        window.setTimeout(() => {
          btn.textContent = prevText || 'Salin';
          btn.classList.remove('is-copied');
        }, 1600);
      } catch {
        btn.textContent = 'Salin manual';
        window.setTimeout(() => {
          btn.textContent = 'Salin';
        }, 1600);
      }
    });
  });
</script>