---
import '~/styles/global.css';
import Seo from '~/components/Seo.astro';
import IconSprite from '~/components/icons/IconSprite.astro';
import Header from '~/components/Header.astro';
import Footer from '~/components/Footer.astro';
import BackToTop from '~/components/BackToTop.astro';
import siteConfig from '~/config/site';

interface Props {
  title: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  type?: 'website' | 'article' | 'profile';
  publishedTime?: string;
  modifiedTime?: string;
  noindex?: boolean;
  appendSiteName?: boolean;
  jsonLd?: string;
  /** Extra class on `<body>`, handy for page-specific tweaks. */
  bodyClass?: string;
}

const { bodyClass, ...seo } = Astro.props;
---

<!doctype html>
<html lang={siteConfig.locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content={siteConfig.themeColor} />
    <meta name="author" content={siteConfig.author} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="alternate" type="application/rss+xml" title={`${siteConfig.name} — Journal`} href="/rss.xml" />

    <!-- Self-hosted fonts: preload only the subsets most visitors need. -->
    <link rel="preload" href="/fonts/space-grotesk-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/inter-tight-latin.woff2" as="font" type="font/woff2" crossorigin />

    <!-- Marks the document as scripted before first paint, so progressive
         enhancements (scroll reveal, the nav drawer) never flash. -->
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>

    <Seo {...seo} />
  </head>

  <body class={bodyClass}>
    <a class="skip-link" href="#main">Skip to content</a>
    <IconSprite />

    <div class="swp-shell">
      <Header />
      <main id="main">
        <slot />
      </main>
      <Footer />
    </div>

    <BackToTop />

    <script>
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      /* --- Scroll reveal --------------------------------------------- */
      {
        const els = document.querySelectorAll<HTMLElement>('.rev');
        if (els.length) {
          if (!('IntersectionObserver' in window) || reduce) {
            els.forEach((el) => el.classList.add('in'));
          } else {
            const io = new IntersectionObserver(
              (entries) => {
                for (const entry of entries) {
                  if (entry.isIntersecting) {
                    entry.target.classList.add('in');
                    io.unobserve(entry.target);
                  }
                }
              },
              { rootMargin: '0px 0px -8% 0px', threshold: 0.08 }
            );
            els.forEach((el) => io.observe(el));
          }
        }
      }

      /* --- Sticky header state + back to top -------------------------- */
      {
        const hdr = document.querySelector('.hdr');
        const totop = document.getElementById('totop');
        let ticking = false;

        const update = () => {
          const y = window.scrollY;
          hdr?.classList.toggle('stuck', y > 12);
          totop?.classList.toggle('on', y > 700);
          ticking = false;
        };

        window.addEventListener(
          'scroll',
          () => {
            if (!ticking) {
              window.requestAnimationFrame(update);
              ticking = true;
            }
          },
          { passive: true }
        );
        update();
      }
    </script>
    <script is:inline>
  (function () {
    function updateChartsTheme() {
      if (!window.Chart || !window.Chart.instances) return;
      const isDark =
        document.documentElement.classList.contains("dark") ||
        document.documentElement.getAttribute("data-theme") === "dark";

      const tickColor = isDark ? "#cbd5e1" : "#475569";
      const legendColor = isDark ? "#f8fafc" : "#0f172a";
      const gridColor = isDark ? "rgba(148, 163, 184, 0.16)" : "rgba(15, 23, 42, 0.08)";

      Object.values(window.Chart.instances).forEach((chart) => {
        if (!chart || !chart.options) return;
        if (chart.options.plugins?.legend?.labels) {
          chart.options.plugins.legend.labels.color = legendColor;
        }
        if (chart.options.scales?.x) {
          chart.options.scales.x.ticks = { ...(chart.options.scales.x.ticks || {}), color: tickColor };
          chart.options.scales.x.grid = { ...(chart.options.scales.x.grid || {}), color: gridColor };
        }
        if (chart.options.scales?.y) {
          chart.options.scales.y.ticks = { ...(chart.options.scales.y.ticks || {}), color: tickColor };
          chart.options.scales.y.grid = { ...(chart.options.scales.y.grid || {}), color: gridColor };
        }
        chart.update();
      });
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", () => setTimeout(updateChartsTheme, 80));
    } else {
      setTimeout(updateChartsTheme, 80);
    }
    document.addEventListener("astro:page-load", () => setTimeout(updateChartsTheme, 80));

    const observer = new MutationObserver(updateChartsTheme);
    observer.observe(document.documentElement, {
      attributes: true,
      attributeFilter: ["class", "data-theme"],
    });
  })();
</script>

<script>
  import { initLanguageSwitcher } from '~/scripts/i18n';

  initLanguageSwitcher();
  document.addEventListener('astro:after-swap', initLanguageSwitcher);
</script>
  </body>
</html>
